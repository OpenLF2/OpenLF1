<component type="desktop-application">
  <id>io.github.openlf2.OpenLF1</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>OpenLF1</name>
  <summary>Play Little Fighter (1995) with a modern engine</summary>
  <description>
    <p>OpenLF1 is an open-source reimplementation of Little Fighter (1995). It includes the introduction, menus, character selection, and side-view battles.</p>
    <ul>
      <li>Play local battles with keyboard or gamepad controls</li>
      <li>Choose from the original fighters, stages, and items</li>
      <li>Use the original game data from a Little Fighter ZIP archive</li>
    </ul>
  </description>
  <url type="homepage">https://openlf2.github.io/OpenLF1/</url>
